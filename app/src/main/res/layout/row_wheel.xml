<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_library_card"
    android:layout_marginBottom="10dp"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#EEEEEE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:textColor="#7CE0B3"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8892A6"
        android:textSize="13sp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_play"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:text="چرخش 🎡"
            android:textColor="#06241A"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_edit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:text="ویرایش ✏️"
            android:textColor="#CCD3E0"
            android:textSize="15sp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/btn_copy"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:text="⧉"
            android:textColor="#CCD3E0"
            android:textSize="17sp"
            android:layout_marginStart="8dp"
            android:contentDescription="کپی" />

        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:text="🗑"
            android:textColor="#FF7B7B"
            android:textSize="17sp"
            android:layout_marginStart="8dp"
            android:contentDescription="حذف" />
    </LinearLayout>
</LinearLayout>
